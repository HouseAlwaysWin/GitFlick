<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFlick.ViewModels"
        xmlns:loc="using:GitFlick.Markup"
        xmlns:edit="using:AvaloniaEdit"
        x:Class="GitFlick.Views.ConflictWindow"
        x:DataType="vm:ConflictResolverViewModel"
        Title="{loc:Tr Conflict_Title}"
        Icon="/Assets/gitflick.ico"
        Width="1060" Height="720"
        MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- Bottom action bar: abort (throws work away) on the left, complete on the right. Complete is
             only enabled once nothing is unresolved. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Classes="danger" Content="{loc:Tr Conflict_Abort}"
                    Command="{Binding AbortMergeCommand}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding StatusText}" />
            <Button Grid.Column="2" Classes="primary" Content="{loc:Tr Conflict_Complete}"
                    Command="{Binding CompleteMergeCommand}" IsEnabled="{Binding !HasUnresolved}" />
        </Grid>

        <!-- Left: the unresolved-path list. Resolving a file drops it out of here. -->
        <Border DockPanel.Dock="Left" Width="270" Margin="0,0,10,0"
                BorderBrush="#30808080" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Panel>
                <ListBox ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConflictFile">
                            <StackPanel Spacing="1" Margin="0,2">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{loc:Tr Conflict_AllResolved}" IsVisible="{Binding !HasUnresolved}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                           TextWrapping="Wrap" MaxWidth="220" TextAlignment="Center" />
            </Panel>
        </Border>

        <!-- Right: resolve the selected path. -->
        <DockPanel>
            <!-- Per-file actions. Take-a-side captions come from the marker labels (never "ours/theirs"). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6"
                        IsVisible="{Binding HasSelection}">
                <Button Content="{Binding TakeOursCaption}" Command="{Binding TakeOursCommand}"
                        IsVisible="{Binding CanTakeSide}" />
                <Button Content="{Binding TakeTheirsCaption}" Command="{Binding TakeTheirsCommand}"
                        IsVisible="{Binding CanTakeSide}" />
                <Button Content="{loc:Tr Conflict_Save}" Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsTextConflict}" />
                <Button Content="{loc:Tr Conflict_MarkResolved}" Classes="primary"
                        Command="{Binding MarkResolvedCommand}" IsVisible="{Binding IsTextConflict}" />
                <Button Content="{loc:Tr Conflict_KeepFile}" Command="{Binding KeepFileCommand}"
                        IsVisible="{Binding IsModifyDelete}" />
                <Button Content="{loc:Tr Conflict_AcceptDeletion}" Classes="danger"
                        Command="{Binding AcceptDeletionCommand}" IsVisible="{Binding ShowAcceptDeletion}" />
            </StackPanel>

            <!-- Footgun guard: the file still has conflict markers, which `git add` won't catch. -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding HasStaleMarkers}" Margin="0,0,0,6"
                    Background="#40F0A030" BorderBrush="#F0A030" BorderThickness="1" CornerRadius="4" Padding="8,4">
                <TextBlock Text="{loc:Tr Conflict_StaleMarkers}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <Border BorderBrush="#30808080" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Panel>
                    <!-- Text conflict: the editable file, markers and all. -->
                    <edit:TextEditor x:Name="ConflictEditor"
                                     IsVisible="{Binding IsTextConflict}"
                                     ShowLineNumbers="True"
                                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                     WordWrap="False"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

                    <!-- Non-text conflict (binary, modify/delete, other): explain, no editor. -->
                    <TextBlock Text="{Binding ResolutionHint}"
                               IsVisible="{Binding ResolutionHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                </Panel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
